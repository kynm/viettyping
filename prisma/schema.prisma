generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String          @id @default(cuid())
  username     String          @unique @db.VarChar(30)
  passwordHash String          @map("password_hash") @db.VarChar(191)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  profile      StudentProfile?
  studentData  StudentData?
  sessions     Session[]

  @@map("users")
}

model StudentProfile {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  name      String   @default("") @db.VarChar(120)
  nickname  String   @default("") @db.VarChar(80)
  grade     String   @default("Lớp 1") @db.VarChar(30)
  avatar    String   @default("🦖") @db.VarChar(20)
  theme     String   @default("dino") @db.VarChar(30)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model StudentData {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  data      Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_data")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}
